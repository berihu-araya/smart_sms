# Smart SMS - Production Backend Environment Variables Example
# Copy this file to .env.production on your production server

NODE_ENV=production
PORT=5000

# PostgreSQL Database Configuration
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=smart_sms_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_DATABASE_PASSWORD
DATABASE_NAME=smart_sms_prod

# JSON Web Token Security
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_REFRESH_SECRET_KEY
JWT_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_HOURS=1

# Redis Cache & Sessions (Optional)
REDIS_URL=redis://redis:6379

# Allowed CORS Origins (Comma-separated list of allowed domains)
CORS_ORIGIN=https://sms.yourdomain.com

# Odoo ERP Integration (Optional)
ODOO_ENABLED=false
ODOO_URL=http://localhost:8070
ODOO_DB=odoo
ODOO_LOGIN=admin
ODOO_PASSWORD=your_odoo_password
ODOO_API_KEY=your_odoo_api_key
